+
+
+    // Rotation deviation statistics (LK vs motion model)
+    if(!mvLKRotDevAdopted.empty() || !mvLKRotDevRejected.empty())
+    {
+        cout << endl << "====== LK Rotation Deviation (LK vs MM) ======" << endl;
+        cout << "adopted samples: " << mvLKRotDevAdopted.size()
+             << "  rejected samples: " << mvLKRotDevRejected.size() << endl;
+        if(!mvLKRotDevAdopted.empty())
+        {
+            std::vector<float> v = mvLKRotDevAdopted;
+            std::sort(v.begin(), v.end());
+            float sum = 0;
+            for(float x : v) sum += x;
+            cout << "adopted rot dev: mean " << (sum/v.size())
+                 << " med " << v[v.size()/2] << " max " << v.back()
+                 << " p95 " << v[(int)(0.95*v.size())] << " deg" << endl;
+        }
+        if(!mvLKRotDevRejected.empty())
+        {
+            std::vector<float> v = mvLKRotDevRejected;
+            std::sort(v.begin(), v.end());
+            float sum = 0;
+            for(float x : v) sum += x;
+            cout << "rejected rot dev: mean " << (sum/v.size())
+                 << " med " << v[v.size()/2] << " max " << v.back()
+                 << " p95 " << v[(int)(0.95*v.size())] << " deg" << endl;
+        }
+        if(!mvLKTransDevAdopted.empty())
+        {
+            std::vector<float> v = mvLKTransDevAdopted;
+            std::sort(v.begin(), v.end());
+            float sum = 0;
+            for(float x : v) sum += x;
+            cout << "adopted trans dev: mean " << (sum/v.size())
+                 << " med " << v[v.size()/2] << " max " << v.back() << " m" << endl;
+        }
+        if(!mvLKTransDevRejected.empty())
+        {
+            std::vector<float> v = mvLKTransDevRejected;
+            std::sort(v.begin(), v.end());
+            float sum = 0;
+            for(float x : v) sum += x;
+            cout << "rejected trans dev: mean " << (sum/v.size())
+                 << " med " << v[v.size()/2] << " max " << v.back() << " m" << endl;
+        }
+        cout << "====================================================" << endl;
+    }
+
+    // Per-frame tracking time statistics
+    if(!mvTrackTimesMs.empty())
+    {
+        std::vector<float> v = mvTrackTimesMs;
+        std::sort(v.begin(), v.end());
+        float sum = 0;
+        for(float x : v) sum += x;
+        float mean = sum / v.size();
+        float var = 0;
+        for(float x : v) var += (x-mean)*(x-mean);
+        float stdv = sqrt(var / v.size());
+        cout << endl << "====== Tracking Time Statistics (ms) ======" << endl;
+        cout << "Frames:    " << v.size() << endl;
+        cout << "Mean:      " << mean << endl;
+        cout << "Median:    " << v[v.size()/2] << endl;
+        cout << "Std:       " << stdv << endl;
+        cout << "Min:       " << v.front() << endl;
+        cout << "Max:       " << v.back() << endl;
+        cout << "P95:       " << v[(int)(0.95*v.size())] << endl;
+        cout << "P99:       " << v[(int)(0.99*v.size())] << endl;
+        cout << "===========================================" << endl << endl;
+
+        // Save raw per-frame times for boxplots
+        ofstream fout("track_times_ms.txt");
+        for(float x : v) fout << x << endl;
+        fout.close();
+    }
+}
