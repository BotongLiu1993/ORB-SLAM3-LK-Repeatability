+             << " (" << (100.0*mnLKUsed/mnLKFrames) << "% of frames)" << endl;
+        if(mnLKAttempts > 0)
+            cout << "LK success rate:       "
+                 << (100.0*mnLKUsed/mnLKAttempts) << "% (of attempts)" << endl;
+        if(mnLKUsed > 0)
+            cout << "Avg tracked points:    "
+                 << (float)mnLKTrackedSum/mnLKUsed << endl;
+        cout << "====================================" << endl;
