+// ============================================================================
+// LK-v2: normalized cross-correlation of a (2r+1)x(2r+1) patch around p in im1
+// and q in im2. Lightweight appearance check on top of the forward-backward
+// consistency test.
+// ============================================================================
+static float LK_NCC_Patch(const cv::Mat& im1, const cv::Mat& im2,
+                          const cv::Point2f& p, const cv::Point2f& q, int r = 4)
+{
+    const int s = 2*r + 1;
+    cv::Mat_<float> A(s, s), B(s, s);
+    const int x1c = (int)std::lround(p.x), y1c = (int)std::lround(p.y);
+    const int x2c = (int)std::lround(q.x), y2c = (int)std::lround(q.y);
+    for(int dy = -r; dy <= r; dy++)
+    {
+        for(int dx = -r; dx <= r; dx++)
+        {
+            const int x1 = x1c + dx, y1 = y1c + dy;
+            const int x2 = x2c + dx, y2 = y2c + dy;
+            A(dy+r, dx+r) = (x1 >= 0 && y1 >= 0 && x1 < im1.cols && y1 < im1.rows)
+                                ? (float)im1.at<uchar>(y1, x1) : 0.0f;
+            B(dy+r, dx+r) = (x2 >= 0 && y2 >= 0 && x2 < im2.cols && y2 < im2.rows)
+                                ? (float)im2.at<uchar>(y2, x2) : 0.0f;
+        }
+    }
+    cv::Scalar mA = cv::mean(A), mB = cv::mean(B);
+    cv::Mat dA = A - mA[0];
+    cv::Mat dB = B - mB[0];
+    double num = dA.dot(dB);
+    double den = cv::norm(dA, cv::NORM_L2) * cv::norm(dB, cv::NORM_L2);
+    return (den > 1e-9) ? (float)(num / den) : -1.0f;
+}
